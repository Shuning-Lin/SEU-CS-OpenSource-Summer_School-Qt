 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>900</width>
    <height>600</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>900</width>
    <height>600</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>石蕗高中轻小说系统</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow#MainWindow {
    background-color: #F5F9FC;
    color: #2F3B46;
    font-family: &quot;Microsoft YaHei UI&quot;;
    font-size: 10pt;
}
QLabel#labelAppTitle {
    color: #29465F;
    background-color: rgba(255, 255, 255, 218);
    border: 1px solid rgba(201, 220, 235, 210);
    border-radius: 9px;
    padding: 8px 12px;
}
QLabel#labelCurrentUser {
    color: #3D566C;
    background-color: rgba(255, 255, 255, 220);
    border: 1px solid rgba(201, 220, 235, 210);
    border-radius: 8px;
    padding: 6px 9px;
}
QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #D5E3ED;
    border-radius: 8px;
    top: -1px;
}
QTabBar::tab {
    background-color: #E9F2F8;
    color: #466176;
    border: 1px solid #D5E3ED;
    padding: 8px 13px;
    margin-right: 2px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}
QTabBar::tab:hover {
    background-color: #DCEBF5;
}
QTabBar::tab:selected {
    background-color: #4F86B7;
    color: white;
    border-color: #4F86B7;
}
QLineEdit, QComboBox, QDateEdit {
    background-color: #FFFFFF;
    color: #2F3B46;
    border: 1px solid #C9DCEB;
    border-radius: 7px;
    padding: 5px 7px;
    min-height: 24px;
    selection-background-color: #8DB7D8;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 1px solid #6D9FC7;
}
QTableView, QListWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8FBFD;
    color: #2F3B46;
    border: 1px solid #D5E3ED;
    border-radius: 7px;
    gridline-color: #E5EDF3;
    selection-background-color: #BFD8EA;
    selection-color: #243746;
    outline: 0;
}
QHeaderView::section {
    background-color: #E7F0F7;
    color: #3E5B72;
    border: none;
    border-right: 1px solid #D2E1EB;
    border-bottom: 1px solid #CBDCE8;
    padding: 7px;
    font-weight: 600;
}
QPushButton {
    background-color: #4F86B7;
    color: white;
    border: none;
    border-radius: 7px;
    padding: 6px 13px;
    min-height: 26px;
}
QPushButton:hover {
    background-color: #3F739F;
}
QPushButton:pressed {
    background-color: #345F84;
}
QPushButton:disabled {
    background-color: #CFD9E0;
    color: #8695A1;
}
QPushButton#btnLike {
    background-color: #D8A84F;
}
QPushButton#btnLike:hover {
    background-color: #C4943C;
}
QPushButton#btnReport,
QPushButton#btnReject,
QPushButton#btnWithdraw,
QPushButton#btnWithdrawByReport,
QPushButton#btnCleanDelete,
QPushButton#btnDeleteWord {
    background-color: #C96B70;
}
QPushButton#btnReport:hover,
QPushButton#btnReject:hover,
QPushButton#btnWithdraw:hover,
QPushButton#btnWithdrawByReport:hover,
QPushButton#btnCleanDelete:hover,
QPushButton#btnDeleteWord:hover {
    background-color: #B8585E;
}
QMenuBar {
    background-color: #EDF4F8;
    color: #324B60;
}
QMenuBar::item:selected, QMenu::item:selected {
    background-color: #CFE2F0;
}
QStatusBar {
    background-color: #EDF4F8;
    color: #536B7D;
}</string>
