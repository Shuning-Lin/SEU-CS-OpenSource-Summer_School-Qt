  <property name="styleSheet">
   <string notr="true">QDialog#ArticleEditDialog {
    background-color: #F5F9FC;
    color: #2F3B46;
    font-family: "Microsoft YaHei UI";
    font-size: 10pt;
}
QLabel#labelTitle, QLabel#labelContent {
    color: #355A78;
    font-weight: 600;
}
QLabel#labelCharCount {
    color: #748896;
}
QLineEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #2F3B46;
    border: 1px solid #C9DCEB;
    border-radius: 7px;
    padding: 7px 9px;
    selection-background-color: #8DB7D8;
}
QLineEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #6D9FC7;
}
QPushButton {
    background-color: #4F86B7;
    color: white;
    border: none;
    border-radius: 7px;
    padding: 7px 16px;
    min-height: 26px;
}
QPushButton:hover {
    background-color: #3F739F;
}
QPushButton#btnCancel {
    background-color: #E5EDF3;
    color: #42596C;
}
QPushButton#btnCancel:hover {
    background-color: #D4E1EA;
}</string>
  </property>
